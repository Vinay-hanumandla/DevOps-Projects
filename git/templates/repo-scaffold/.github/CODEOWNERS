# Default owners for every file in the repository.
# The last matching pattern wins. Use this file to route review requests
# to the right team without asking every contributor to remember it.
*       @your-org/reviewers

# Documentation lives under docs/ — route it to the docs team.
docs/   @your-org/docs-team

# Infrastructure and CI definitions live under .github/ — route to platform.
.github/        @your-org/platform-team

# Source lives under src/ — route to the app team.
src/    @your-org/app-team

# Tests live under tests/ — the app team owns them too.
tests/  @your-org/app-team