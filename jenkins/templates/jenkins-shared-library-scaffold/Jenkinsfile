// last_verified: 2026-10-14 · Jenkins shared library scaffold
// Example pipeline demonstrating all shared library steps.
// Reference the library with: @Library('jenkins-shared-library-scaffold') _

@Library('jenkins-shared-library-scaffold') _

pipeline {
    agent any

    environment {
        REGISTRY = 'registry.example.com'
        IMAGE_NAME = 'example-app'
        NAMESPACE = 'default'
        DEPLOYMENT = 'example-app'
    }

    stages {
        stage('Checkout & Lint') {
            steps {
                script {
                    env.CHECKED_OUT_REVISION = checkoutAndLint([
                        repoUrl: 'https://github.com/example/example-app.git',
                        branch: 'main',
                        credentialsId: 'github-credentials-id',
                        lintCommand: 'npm ci && npm run lint'
                    ])
                }
            }
        }

        stage('Build & Push Docker Image') {
            steps {
                script {
                    env.IMAGE_REF = buildAndPushDocker([
                        image: env.IMAGE_NAME,
                        tag: "${env.BUILD_NUMBER}",
                        registry: env.REGISTRY,
                        credentialsId: 'registry-credentials-id',
                        buildArgs: [VERSION: '1.0.0', BUILD_NUMBER: env.BUILD_NUMBER],
                        cacheFrom: "${env.REGISTRY}/${env.IMAGE_NAME}:latest"
                    ])
                }
            }
        }

        stage('Security Scan') {
            steps {
                script {
                    scanImage([
                        imageRef: env.IMAGE_REF,
                        severity: 'HIGH,CRITICAL',
                        format: 'json',
                        output: 'trivy-report.json'
                    ])
                    archiveArtifacts artifacts: 'trivy-report.json', fingerprint: true
                }
            }
        }

        stage('Run Tests') {
            parallel {
                stage('Unit Tests') {
                    steps {
                        script {
                            runTests([
                                imageRef: env.IMAGE_REF,
                                testCommand: 'npm run test:unit',
                                coverageCommand: 'npm run test:coverage'
                            ])
                        }
                    }
                }
                stage('Integration Tests') {
                    steps {
                        script {
                            runTests([
                                imageRef: env.IMAGE_REF,
                                testCommand: 'npm run test:integration',
                                envVars: [TEST_DB_URL: 'postgresql://test:test@localhost:5432/testdb']
                            ])
                        }
                    }
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                script {
                    deployToK8s([
                        imageRef: env.IMAGE_REF,
                        namespace: env.NAMESPACE,
                        deployment: env.DEPLOYMENT,
                        kubeconfigId: 'kubeconfig-credentials-id',
                        strategy: 'rolling'
                    ])
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
        success {
            script {
                slackNotify([
                    webhookId: 'slack-webhook-id',
                    status: 'SUCCESS',
                    message: "Build ${env.BUILD_NUMBER} deployed successfully!"
                ])
            }
        }
        failure {
            script {
                slackNotify([
                    webhookId: 'slack-webhook-id',
                    status: 'FAILURE',
                    message: "Build ${env.BUILD_NUMBER} failed!"
                ])
            }
        }
    }
}