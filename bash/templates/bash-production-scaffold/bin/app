#!/usr/bin/env bash
# last_verified: 2026-08-25 · bash 5.3.15
set -Eeuo pipefail

LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/../lib" && pwd)"
# shellcheck source=../lib/logging.sh
source "$LIB_DIR/logging.sh"
# shellcheck source=../lib/retry.sh
source "$LIB_DIR/retry.sh"
# shellcheck source=../lib/flock.sh
source "$LIB_DIR/flock.sh"
# shellcheck source=../lib/env.sh
source "$LIB_DIR/env.sh"

main() {
    local workdir
    workdir="$(mktemp -d)"
    trap 'rm -rf "$workdir"' EXIT

    env_assert "APP_HOME"
    require_cmd curl

    local lockfile="/var/tmp/app.lock"
    with_flock "$lockfile" -- run_work "$workdir"
}

run_work() {
    local workdir="$1"
    log "Working in $workdir"
    with_retry 3 5 date || fail "Command failed after retries"
    log "Done"
}

main "$@"
