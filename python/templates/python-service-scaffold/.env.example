# last_verified: 2026-10-03 · python n/a
# Every value here is the default declared in src/app/config.py.
# Copy to .env and edit; never commit .env itself.

APP_NAME=python-service-scaffold
ENVIRONMENT=local
LOG_LEVEL=INFO

# A SQLite file in the working directory. For a server, use a SQLAlchemy URL
# such as postgresql+psycopg://user:password@localhost:5432/python_service
DATABASE_URL=sqlite:///./app.db

# Echo every statement the engine emits.
SQL_ECHO=false