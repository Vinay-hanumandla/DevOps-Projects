# last_verified: 2026-10-05 · ansible 2.21.4
# ansible-023 — pinned inputs for build-ee.sh. Level: L5 | Output: template
#
# cp .env.example .env, then edit. build-ee.sh sources .env and lets its own
# command-line flags win, so CI can override any of these per run.
#
# Nothing in this file carries a version the scaffold verified. Pin the base
# image and the scanner to whatever the platform team approved, and keep the
# pins in version control — that is the whole point of the file.

# Execution-environment base image. Both Containerfile stages build FROM it, and
# it is supplied as a build arg with no default in the Containerfile, so leaving
# it unset fails the build instead of silently substituting a tool default.
# Reference it by digest once it is approved.
EE_BASE_IMAGE=REPLACE_WITH_PINNED_BASE_IMAGE_BY_DIGEST

# Name and tag of the built execution environment. If EE_IMAGE already carries a
# tag, that tag wins and EE_TAG is ignored.
EE_IMAGE=REPLACE_ME/execution-environment
EE_TAG=dev

# Files the build reads. EE_REQUIREMENTS must be reachable from EE_CONTEXT,
# because the Containerfile copies it from the build context by name.
EE_CONTEXT=.
EE_CONTAINERFILE=Containerfile
EE_REQUIREMENTS=requirements.yml

# Container engine used to inspect and run the image after the build. Leave
# empty to auto-detect: podman first, then docker.
CONTAINER_ENGINE=

# ansible-core version the built image is expected to report. 2.21.4 is the
# current GA ansible-core release; verify-ee.sh warns when the image disagrees,
# because a silent core-version drift inside an EE is invisible until a job
# template behaves differently from the controller you tested on.
EXPECTED_CORE_VERSION=2.21.4

# Scan gate. A finding at any listed severity exits the pipeline with
# TRIVY_EXIT_CODE. Narrowing this list is a decision to record in review, not a
# fix to make silently.
TRIVY_SEVERITIES=HIGH,CRITICAL
TRIVY_EXIT_CODE=1

# Where the CycloneDX SBOM document is written.
ARTIFACT_DIR=./artifacts

# Push the image after the scan gate passes. Keep it false while iterating: the
# gate runs against the local image, and an unscanned image never reaches the
# registry.
PUSH=false